{
  "name": "nuzli",
  "private": true,
  "version": "0.1.0",
  "description": "نزلي — إدارة المشاريع والفرق الميدانية",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @nuzli/web dev",
    "dev:api": "pnpm --filter @nuzli/api start:dev",
    "build:pages": "pnpm --filter @nuzli/web build:demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
