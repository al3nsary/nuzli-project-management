// Nuzli data model (brief §11). Refined, never shrunk.
// Anything Prisma cannot express (partial unique indexes, CHECK constraints, triggers)
// lives as raw SQL in prisma/migrations/*/migration.sql — see the "raw SQL" comments below.
//
// Conventions: UUID ids (gen_random_uuid()), snake_case tables/columns, timestamptz in UTC,
// created_at / updated_at / created_by on every business table, archived_at for soft delete.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────── enums

enum Role {
  ADMIN
  SUPERVISOR
  MONITOR
}

/// A12: the account layer (ADR-142).
enum AccountRole {
  OWNER
  USER
}

/// A12: the role of a user inside one workspace.
enum WorkspaceRole {
  ADMIN
  ASSISTANT
  SUPERVISOR
  MONITOR
  MEMBER
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum TeamStatus {
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectAccessLevel {
  VIEW
}

enum TaskType {
  TASK
  GROUP
  MILESTONE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// A9 hours (ADR-109): scheduling unit of a project.
enum DurationUnit {
  DAY
  HOUR
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationStatus {
  SUBMITTED
  UNDER_REVIEW
  CONFIRMED
  CANCELLED
}

enum ViolationFileKind {
  ID_CARD
  EVIDENCE
  /// A9: a photo of the person (owner decision 4).
  PERSON
}

/// A9: a member is a worker or the team's worker foreman (مشرف عمّال) — a record only.
enum MembershipRole {
  WORKER
  FOREMAN
}

enum OrgUnitKind {
  DEPARTMENT
  SECTION
  UNIT
  TEAM_GROUP
}

enum OcrStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum VisibilityMode {
  INHERIT
  SHOW
  HIDE
}

enum FileStatus {
  PENDING
  READY
}

enum CardOrientation {
  LANDSCAPE
  PORTRAIT
}

enum CardLayoutKey {
  CLASSIC_HORIZONTAL
  VERTICAL_BADGE
  COMPACT_LABEL
}

// ───────────────────────────────────────────────────────────── users & auth

/// Registration requests are folded into users.status = PENDING (ADR-008).
model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName             String      @map("full_name")
  email                String      @unique
  /// E.164, e.g. +966512345678
  mobile               String      @unique
  /// AES-256-GCM ciphertext (iv|tag|data), see ADR-011.
  nationalIdEnc        Bytes       @map("national_id_enc")
  /// HMAC-SHA256 blind index for uniqueness and exact lookup.
  nationalIdHash       String      @unique @map("national_id_hash")
  /// Last two digits, kept for masking without decrypting.
  nationalIdLast2      String      @map("national_id_last2") @db.Char(2)
  nationalIdFirst      String      @map("national_id_first") @db.Char(1)
  passwordHash         String?     @map("password_hash")
  /// A12: unique login name, case-insensitive (stored lower case; CHECK in raw SQL).
  username             String      @unique
  /// A12: OWNER sees every workspace; USER rights come from workspace_memberships.
  accountRole          AccountRole @default(USER) @map("account_role")
  /// Legacy (pre-A12) global role, frozen at the A12 migration and never read by the API:
  /// rights come from workspace_memberships (ADR-142). Dropped in a later release.
  role                 Role?
  /// A12: the workspace a registration applies to (PENDING users).
  requestedWorkspaceId String?     @map("requested_workspace_id") @db.Uuid
  requestedRole        Role?       @map("requested_role")
  requestedTeamName    String?     @map("requested_team_name")
  status               UserStatus  @default(PENDING)
  rejectionReason      String?     @map("rejection_reason")
  mustChangePassword   Boolean     @default(false) @map("must_change_password")
  failedLoginCount     Int         @default(0) @map("failed_login_count")
  lockedUntil          DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt          DateTime?   @map("last_login_at") @db.Timestamptz(3)
  preferences          Json        @default("{}")
  approvedAt           DateTime?   @map("approved_at") @db.Timestamptz(3)
  approvedById         String?     @map("approved_by") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById          String?     @map("created_by") @db.Uuid
  archivedAt           DateTime?   @map("archived_at") @db.Timestamptz(3)
  /// Profile photo (owner request A8). The old file is deleted on replacement.
  photoFileId          String?     @map("photo_file_id") @db.Uuid

  photo              File?                   @relation("UserPhoto", fields: [photoFileId], references: [id])
  refreshTokens      RefreshToken[]
  actionTokens       ActionToken[]
  ledTeams           Team[]                  @relation("TeamSupervisor")
  supervisorHistory  TeamSupervisorHistory[]
  member             TeamMember?             @relation("MemberUser")
  assignedTasks      Task[]                  @relation("TaskAssignee")
  ownedProjects      Project[]               @relation("ProjectOwner")
  projectAccess      ProjectAccess[]
  recordedViolations Violation[]             @relation("ViolationRecorder")
  snapshotViolations Violation[]             @relation("ViolationSupervisorSnapshot")
  violationResponses ViolationResponse[]
  notifications      Notification[]
  auditEntries       AuditLog[]
  taskComments       TaskComment[]
  printBatches       CardPrintBatch[]
  printItems         CardPrintItem[]
  movedMemberships   TeamMembership[]        @relation("MembershipMovedBy")
  // A9
  timeEntries        TimeEntry[]
  viewPrefs          UserViewPref[]
  commentReads       TaskCommentRead[]
  checklistDone      TaskChecklistItem[]     @relation("ChecklistDoneBy")
  // A9 — teams, org, violations
  teamSupervisions   TeamSupervisor[]        @relation("TeamSupervisorUser")
  orgPositions       OrgPosition[]           @relation("OrgPositionUser")
  assignedViolations Violation[]             @relation("ViolationAssignedBy")
  // A12
  memberships        WorkspaceMembership[]   @relation("MembershipUser")
  requestedWorkspace Workspace?              @relation("RequestedWorkspace", fields: [requestedWorkspaceId], references: [id], onDelete: SetNull)

  @@index([role, status])
  @@index([requestedWorkspaceId, status])
  @@index([status])
  @@index([photoFileId])
  @@map("users")
}

/// Rotating refresh tokens, stored hashed, with reuse detection by family (ADR-010).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  /// A12: the workspace the session is bound to (kept across refreshes; null = none chosen yet).
  workspaceId  String?   @map("workspace_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation("SessionWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One-time tokens for set-password (admin-created users) and password reset.
model ActionToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String // SET_PASSWORD | RESET_PASSWORD
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("action_tokens")
}

// ───────────────────────────────────────────────────────────── A12 — workspaces (ADR-142)

/// A workspace (قسم): a complete, isolated copy of the business system. Never deleted, only
/// archived (no cross-workspace cascades). Global table (no RLS).
model Workspace {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// Stable machine code, e.g. "projects". Unique, lower case.
  code        String          @unique
  status      WorkspaceStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?         @map("created_by") @db.Uuid
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)

  memberships             WorkspaceMembership[]
  requestedBy             User[]                  @relation("RequestedWorkspace")
  sessions                RefreshToken[]          @relation("SessionWorkspace")
  teamColors              TeamColor[]
  teams                   Team[]
  teamSupervisors         TeamSupervisor[]
  teamSupervisorHistories TeamSupervisorHistory[]
  teamMembers             TeamMember[]
  teamMemberships         TeamMembership[]
  departments             Department[]
  jobTitles               JobTitle[]
  orgUnits                OrgUnit[]
  orgPositions            OrgPosition[]
  calendars               Calendar[]
  calendarExceptions      CalendarException[]
  projects                Project[]
  projectAccess           ProjectAccess[]
  tasks                   Task[]
  taskDependencies        TaskDependency[]
  taskComments            TaskComment[]
  projectLabels           ProjectLabel[]
  taskLabels              TaskLabel[]
  customFields            CustomField[]
  taskCustomValues        TaskCustomValue[]
  taskChecklistItems      TaskChecklistItem[]
  userViewPrefs           UserViewPref[]
  portfolios              Portfolio[]
  portfolioProjects       PortfolioProject[]
  timeEntries             TimeEntry[]
  taskCommentReads        TaskCommentRead[]
  baselines               Baseline[]
  baselineTasks           BaselineTask[]
  violationTypes          ViolationType[]
  violations              Violation[]
  violationOcrs           ViolationOcr[]
  violationFiles          ViolationFile[]
  violationResponses      ViolationResponse[]
  violationVisibilities   ViolationVisibility[]
  importPreviews          ImportPreview[]
  files                   File[]
  logos                   Logo[]
  cardSizes               CardSize[]
  cardTemplates           CardTemplate[]
  cardPrintBatchs         CardPrintBatch[]
  cardPrintItems          CardPrintItem[]
  notifications           Notification[]
  settings                Setting[]
  auditLogs               AuditLog[]

  @@map("workspaces")
}

/// A user's role in one workspace. Identity layer: a global table (no RLS) that the API always
/// filters explicitly by workspace and user.
model WorkspaceMembership {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                    @map("workspace_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  role        WorkspaceRole
  /// Free-text position (منصب), A12 round 2.
  title       String?
  /// A12 round 2 (assistants): per-module rights.
  permissions Json                      @default("{}")
  /// A12 round 2: limit to some projects / teams.
  scope       Json                      @default("{}")
  status      WorkspaceMembershipStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?                   @map("created_by") @db.Uuid
  archivedAt  DateTime?                 @map("archived_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, role])
  @@index([userId])
  @@map("workspace_memberships")
}

// ───────────────────────────────────────────────────────────── teams

model TeamColor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  hex         String    @db.Char(7)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by") @db.Uuid

  teams Team[]

  @@unique([workspaceId, hex])
  @@index([workspaceId])
  @@map("team_colors")
}

/// raw SQL: CREATE UNIQUE INDEX teams_color_reserved_uq ON teams(color_id)
///          WHERE status IN ('ACTIVE','PENDING_APPROVAL');
model Team {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId  String     @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  colorId      String     @map("color_id") @db.Uuid
  supervisorId String     @map("supervisor_id") @db.Uuid
  status       TeamStatus @default(ACTIVE)
  approvedAt   DateTime?  @map("approved_at") @db.Timestamptz(3)
  approvedById String?    @map("approved_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?    @map("created_by") @db.Uuid
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  /// A9: optional link to the organisational structure.
  orgUnitId    String?    @map("org_unit_id") @db.Uuid

  color             TeamColor               @relation(fields: [colorId], references: [id])
  /// The PRIMARY supervisor, kept in sync with team_supervisors for compatibility (ADR-100).
  supervisor        User                    @relation("TeamSupervisor", fields: [supervisorId], references: [id])
  supervisorHistory TeamSupervisorHistory[]
  supervisors       TeamSupervisor[]
  memberships       TeamMembership[]
  violations        Violation[]             @relation("ViolationTeamSnapshot")
  visibility        ViolationVisibility?
  orgUnit           OrgUnit?                @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  @@index([colorId])
  @@index([supervisorId])
  @@index([status])
  @@index([orgUnitId])
  @@index([workspaceId])
  @@map("teams")
}

/// A9 (ADR-100): every supervisor of a team over time; "leads the team" = an open row.
/// raw SQL: partial unique indexes — one open row per (team, user); one open primary per team;
///          CHECK (valid_to IS NULL OR valid_to > valid_from); trigger: user role SUPERVISOR.
model TeamSupervisor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  teamId      String    @map("team_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  isPrimary   Boolean   @default(false) @map("is_primary")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(3)
  addedById   String?   @map("added_by") @db.Uuid
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamSupervisorUser", fields: [userId], references: [id])

  @@index([teamId, validTo])
  @@index([userId, validTo])
  @@index([workspaceId])
  @@map("team_supervisors")
}

/// Superseded by team_supervisors (A9, ADR-100): rows were copied by the migration and nothing
/// writes here any more. Kept read-only for one release, then dropped.
/// raw SQL: partial unique index — one open row per team (valid_to IS NULL).
model TeamSupervisorHistory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId  String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  teamId       String    @map("team_id") @db.Uuid
  supervisorId String    @map("supervisor_id") @db.Uuid
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(3)
  changedById  String?   @map("changed_by") @db.Uuid
  reason       String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  supervisor User @relation(fields: [supervisorId], references: [id])

  @@index([teamId, validFrom])
  @@index([supervisorId])
  @@index([workspaceId])
  @@map("team_supervisor_history")
}

/// Team members are records only. `user_id` is the future-login hook (brief §5.4).
model TeamMember {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId     String       @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fullName        String       @map("full_name")
  nationalIdEnc   Bytes        @map("national_id_enc")
  nationalIdHash  String       @map("national_id_hash")
  nationalIdLast4 String       @map("national_id_last4") @db.Char(4)
  nationalIdFirst String       @map("national_id_first") @db.Char(1)
  jobTitleId      String?      @map("job_title_id") @db.Uuid
  jobTitleText    String?      @map("job_title_text")
  departmentId    String?      @map("department_id") @db.Uuid
  departmentText  String?      @map("department_text")
  photoFileId     String?      @map("photo_file_id") @db.Uuid
  userId          String?      @unique @map("user_id") @db.Uuid
  status          MemberStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById     String?      @map("created_by") @db.Uuid
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)

  jobTitle     JobTitle?        @relation(fields: [jobTitleId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  photo        File?            @relation("MemberPhoto", fields: [photoFileId], references: [id])
  user         User?            @relation("MemberUser", fields: [userId], references: [id])
  memberships  TeamMembership[]
  violations   Violation[]
  printItems   CardPrintItem[]
  /// A9: organisational positions this member holds.
  orgPositions OrgPosition[]    @relation("OrgPositionMember")

  @@unique([workspaceId, nationalIdHash])
  @@index([jobTitleId])
  @@index([departmentId])
  @@index([fullName])
  /// Member search by the last four digits of the national ID (GET /members?q=1234).
  @@index([nationalIdLast4])
  @@index([photoFileId])
  @@index([workspaceId])
  @@map("team_members")
}

/// raw SQL: CREATE UNIQUE INDEX team_memberships_one_open_uq ON team_memberships(member_id)
///          WHERE valid_to IS NULL;
///          CHECK (valid_to IS NULL OR valid_to > valid_from)
model TeamMembership {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String         @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  memberId    String         @map("member_id") @db.Uuid
  teamId      String         @map("team_id") @db.Uuid
  validFrom   DateTime       @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime?      @map("valid_to") @db.Timestamptz(3)
  movedById   String?        @map("moved_by") @db.Uuid
  reason      String?
  /// A9: WORKER, or FOREMAN (at most one open FOREMAN per team — partial unique, raw SQL).
  role        MembershipRole @default(WORKER)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  team    Team       @relation(fields: [teamId], references: [id])
  movedBy User?      @relation("MembershipMovedBy", fields: [movedById], references: [id])

  @@index([memberId, validFrom])
  @@index([teamId, validTo])
  @@index([workspaceId])
  @@map("team_memberships")
}

model Department {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String       @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by") @db.Uuid
  members     TeamMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("departments")
}

model JobTitle {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String       @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by") @db.Uuid
  members     TeamMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("job_titles")
}

// ───────────────────────────────────────────────────────────── organisational structure (A9, ADR-102)

/// A tree (no cycles — checked in the service under an advisory lock).
/// raw SQL: CHECK (parent_id IS NULL OR parent_id <> id); partial unique code among live units.
model OrgUnit {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String      @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parentId    String?     @map("parent_id") @db.Uuid
  name        String
  kind        OrgUnitKind
  code        String?
  sort        Float       @default(0)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?     @map("created_by") @db.Uuid
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(3)

  parent    OrgUnit?      @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  OrgUnit[]     @relation("OrgUnitTree")
  positions OrgPosition[]
  teams     Team[]

  @@index([parentId, sort])
  @@index([workspaceId])
  @@map("org_units")
}

/// Held by a user, by a team member, or vacant (both null).
/// raw SQL: CHECK NOT (holder_user_id IS NOT NULL AND holder_member_id IS NOT NULL);
///          CHECK (reports_to_position_id IS NULL OR reports_to_position_id <> id).
model OrgPosition {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId         String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  unitId              String    @map("unit_id") @db.Uuid
  title               String
  holderUserId        String?   @map("holder_user_id") @db.Uuid
  holderMemberId      String?   @map("holder_member_id") @db.Uuid
  reportsToPositionId String?   @map("reports_to_position_id") @db.Uuid
  sort                Float     @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById         String?   @map("created_by") @db.Uuid

  unit         OrgUnit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  holderUser   User?         @relation("OrgPositionUser", fields: [holderUserId], references: [id], onDelete: SetNull)
  holderMember TeamMember?   @relation("OrgPositionMember", fields: [holderMemberId], references: [id], onDelete: SetNull)
  reportsTo    OrgPosition?  @relation("OrgReports", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports      OrgPosition[] @relation("OrgReports")

  @@index([unitId, sort])
  @@index([holderUserId])
  @@index([holderMemberId])
  @@index([reportsToPositionId])
  @@index([workspaceId])
  @@map("org_positions")
}

// ───────────────────────────────────────────────────────────── projects & tasks

model Calendar {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId  String              @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  /// 0 = Sunday … 6 = Saturday. Default weekend Friday + Saturday.
  weekendDays  Int[]               @default([5, 6]) @map("weekend_days")
  isDefault    Boolean             @default(false) @map("is_default")
  /// A9 hours: working intervals of a normal working day, [{ "start": "HH:MM", "end": "HH:MM" }].
  /// Used by HOUR projects only (DAY projects count whole working days).
  workingHours Json                @default("[{\"start\": \"09:00\", \"end\": \"13:00\"}, {\"start\": \"14:00\", \"end\": \"18:00\"}]") @map("working_hours")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?             @map("created_by") @db.Uuid
  exceptions   CalendarException[]
  projects     Project[]

  @@index([workspaceId])
  @@map("calendars")
}

model CalendarException {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId  String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  calendarId   String    @map("calendar_id") @db.Uuid
  date         DateTime  @db.Date
  isWorking    Boolean   @default(false) @map("is_working")
  name         String
  /// A9 hours: the intervals of a special working day (null = the calendar's hours).
  workingHours Json?     @map("working_hours")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by") @db.Uuid

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([workspaceId])
  @@map("calendar_exceptions")
}

model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId  String        @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  startDate    DateTime      @map("start_date") @db.Date
  status       ProjectStatus @default(PLANNING)
  calendarId   String        @map("calendar_id") @db.Uuid
  autoSchedule Boolean       @default(true) @map("auto_schedule")
  /// A9 hours (ADR-109): DAY = date columns on tasks; HOUR = start_at/end_at/duration_minutes too.
  durationUnit DurationUnit  @default(DAY) @map("duration_unit")
  ownerId      String        @map("owner_id") @db.Uuid
  /// Phase 5: created from a template.
  templateOfId String?       @map("template_of_id") @db.Uuid
  isTemplate   Boolean       @default(false) @map("is_template")
  /// A9: budget cap in `currency` (null = none). CHECK >= 0 in raw SQL.
  budget       Decimal?      @db.Decimal(14, 2)
  currency     String        @default("SAR") @db.Char(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?       @map("created_by") @db.Uuid
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(3)

  calendar     Calendar           @relation(fields: [calendarId], references: [id])
  owner        User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  /// ADR-092: kept for admins; grants nothing to supervisors since A9.
  access       ProjectAccess[]
  tasks        Task[]
  dependencies TaskDependency[]
  baselines    Baseline[]
  labels       ProjectLabel[]
  customFields CustomField[]
  portfolios   PortfolioProject[]
  viewPrefs    UserViewPref[]

  @@index([ownerId])
  @@index([calendarId])
  @@index([status])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectAccess {
  projectId   String             @map("project_id") @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String             @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId      String             @map("user_id") @db.Uuid
  level       ProjectAccessLevel @default(VIEW)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?            @map("created_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("project_access")
}

/// raw SQL: trigger tasks_assignee_supervisor_chk — assignee must be an ACTIVE SUPERVISOR.
///          CHECK (progress BETWEEN 0 AND 100); CHECK (type <> 'MILESTONE' OR duration_days = 0)
///          A9 hours (ADR-109): CHECK tasks_hour_columns_chk (start_at, end_at, duration_minutes all
///          set or all null) and the deferred constraint triggers tasks_unit_columns_chk /
///          projects_unit_columns_chk: HOUR project ⇔ the three hour columns are set.
model Task {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId        String     @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId          String     @map("project_id") @db.Uuid
  parentId           String?    @map("parent_id") @db.Uuid
  sortOrder          Float      @default(0) @map("sort_order")
  wbsCache           String     @default("") @map("wbs_cache")
  name               String
  type               TaskType   @default(TASK)
  startDate          DateTime   @map("start_date") @db.Date
  endDate            DateTime   @map("end_date") @db.Date
  durationDays       Int        @default(1) @map("duration_days")
  progress           Decimal    @default(0) @db.Decimal(5, 2)
  status             TaskStatus @default(NOT_STARTED)
  priority           Priority   @default(MEDIUM)
  assigneeId         String?    @map("assignee_id") @db.Uuid
  description        String?
  version            Int        @default(0)
  dueSoonNotifiedAt  DateTime?  @map("due_soon_notified_at") @db.Timestamptz(3)
  overdueNotifiedAt  DateTime?  @map("overdue_notified_at") @db.Timestamptz(3)
  /// A9 budget (project currency). Groups hold the sum of their children (roll-up).
  plannedCost        Decimal    @default(0) @map("planned_cost") @db.Decimal(14, 2)
  actualCost         Decimal    @default(0) @map("actual_cost") @db.Decimal(14, 2)
  /// A9: a deadline separate from the end date.
  deadline           DateTime?  @db.Date
  deadlineNotifiedAt DateTime?  @map("deadline_notified_at") @db.Timestamptz(3)
  /// A9: custom bar colour '#RRGGBB'.
  barColor           String?    @map("bar_color") @db.Char(7)
  /// A9 hours (HOUR projects only): instants of the first working minute and of the end of the
  /// last working minute (exclusive), shown as Asia/Riyadh wall time; working minutes of the task.
  /// start_date/end_date stay set for every task (the day of the first and of the last working minute).
  startAt            DateTime?  @map("start_at") @db.Timestamptz(3)
  endAt              DateTime?  @map("end_at") @db.Timestamptz(3)
  durationMinutes    Int?       @map("duration_minutes")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById        String?    @map("created_by") @db.Uuid
  archivedAt         DateTime?  @map("archived_at") @db.Timestamptz(3)

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Task?               @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Task[]              @relation("TaskTree")
  assignee      User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  predecessors  TaskDependency[]    @relation("DepSuccessor")
  successors    TaskDependency[]    @relation("DepPredecessor")
  comments      TaskComment[]
  baselineTasks BaselineTask[]
  labels        TaskLabel[]
  customValues  TaskCustomValue[]
  checklist     TaskChecklistItem[]
  timeEntries   TimeEntry[]
  commentReads  TaskCommentRead[]

  @@index([projectId, parentId, sortOrder])
  @@index([assigneeId])
  @@index([parentId])
  @@index([endDate])
  @@index([workspaceId])
  @@map("tasks")
}

/// raw SQL: CHECK (predecessor_id <> successor_id)
model TaskDependency {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId   String         @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId     String         @map("project_id") @db.Uuid
  predecessorId String         @map("predecessor_id") @db.Uuid
  successorId   String         @map("successor_id") @db.Uuid
  type          DependencyType @default(FS)
  lagDays       Int            @default(0) @map("lag_days")
  /// A9 hours: lag in working minutes, used by HOUR projects (lag_days stays the rounded day value).
  lagMinutes    Int            @default(0) @map("lag_minutes")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?        @map("created_by") @db.Uuid

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor Task    @relation("DepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task    @relation("DepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
  @@index([workspaceId])
  @@map("task_dependencies")
}

model TaskComment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  taskId      String    @map("task_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String
  mentions    String[]  @db.Uuid
  /// A9: the quoted comment of the same task (flat chat).
  replyToId   String?   @map("reply_to_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id])
  replyTo TaskComment?  @relation("CommentReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies TaskComment[] @relation("CommentReply")

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([workspaceId])
  @@map("task_comments")
}

