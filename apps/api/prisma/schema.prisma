/// Append-only for monitors (edit window enforced in the service).
/// team_id_snapshot / supervisor_id_snapshot are resolved from history at captured_at.
model Violation {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId           String          @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientUuid            String          @unique @map("client_uuid") @db.Uuid
  /// A9 (ADR-103): null until the person is assigned.
  memberId              String?         @map("member_id") @db.Uuid
  teamIdSnapshot        String?         @map("team_id_snapshot") @db.Uuid
  /// The PRIMARY supervisor of the team at captured_at.
  supervisorIdSnapshot  String?         @map("supervisor_id_snapshot") @db.Uuid
  /// A9: every supervisor of the team at captured_at.
  supervisorIdsSnapshot String[]        @default([]) @map("supervisor_ids_snapshot") @db.Uuid
  assignedAt            DateTime?       @map("assigned_at") @db.Timestamptz(3)
  assignedById          String?         @map("assigned_by") @db.Uuid
  /// A9: photos of the person announced at capture (0 for violations recorded before A9).
  expectedPerson        Int             @default(0) @map("expected_person_photos")
  recordedById          String          @map("recorded_by") @db.Uuid
  typeId                String          @map("type_id") @db.Uuid
  description           String
  notes                 String?
  latitude              Float
  longitude             Float
  accuracyM             Float           @map("accuracy_m")
  capturedAt            DateTime        @map("captured_at") @db.Timestamptz(3)
  receivedAt            DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  clientSentAt          DateTime?       @map("client_sent_at") @db.Timestamptz(3)
  clockDriftSuspect     Boolean         @default(false) @map("clock_drift_suspect")
  deviceInfo            Json            @default("{}") @map("device_info")
  expectedIdPhotos      Int             @default(1) @map("expected_id_photos")
  expectedEvidence      Int             @default(1) @map("expected_evidence")
  status                ViolationStatus @default(SUBMITTED)
  cancelReason          String?         @map("cancel_reason")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById           String?         @map("created_by") @db.Uuid

  member     TeamMember?         @relation(fields: [memberId], references: [id])
  team       Team?               @relation("ViolationTeamSnapshot", fields: [teamIdSnapshot], references: [id])
  supervisor User?               @relation("ViolationSupervisorSnapshot", fields: [supervisorIdSnapshot], references: [id])
  recordedBy User                @relation("ViolationRecorder", fields: [recordedById], references: [id])
  assignedBy User?               @relation("ViolationAssignedBy", fields: [assignedById], references: [id])
  type       ViolationType       @relation(fields: [typeId], references: [id])
  files      ViolationFile[]
  responses  ViolationResponse[]
  ocr        ViolationOcr?

  @@index([capturedAt])
  @@index([teamIdSnapshot, capturedAt])
  @@index([recordedById, capturedAt])
  @@index([typeId])
  @@index([memberId])
  /// Member history and repeat-offender queries.
  @@index([memberId, capturedAt])
  @@index([status])
  @@index([latitude, longitude])
  @@index([workspaceId])
  @@map("violations")
}

/// A9 (ADR-104): OCR of the ID-card photo. One row per violation; the extracted fields are
/// encrypted JSON (CryptoService), the ID number has an HMAC blind index. OCR text is never stored or logged.
model ViolationOcr {
  violationId   String    @id @map("violation_id") @db.Uuid
  /// A12: the workspace (قسم) of this row; defaults to the session's app.workspace_id (ADR-142).
  workspaceId   String    @default(dbgenerated("nz_current_workspace()")) @map("workspace_id") @db.Uuid
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// The ID_CARD file that was read.
  fileId        String?   @map("file_id") @db.Uuid
  status        OcrStatus @default(PENDING)
  attempts      Int       @default(0)
  /// Short failure reason (engine error class), never OCR text.
  error         String?
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  extractedEnc  Bytes?    @map("extracted_enc")
  idNumberHash  String?   @map("id_number_hash")
  extractedAt   DateTime? @map("extracted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([idNumberHash])
  @@index([workspaceId])
  @@map("violation_ocr")
}

/// raw SQL: CREATE UNIQUE INDEX violation_files_one_id_card_uq ON violation_files(violation_id)
///          WHERE kind = 'ID_CARD';  (one ID-card photo per violation)
///          A9: violation_files_one_person_uq — one PERSON photo per violation.
model ViolationFile {
