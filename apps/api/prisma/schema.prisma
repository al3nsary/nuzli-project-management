  batch  CardPrintBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  member TeamMember?    @relation(fields: [memberId], references: [id])
  user   User?          @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([memberId])
  @@index([userId])
  @@index([workspaceId])
  @@map("card_print_items")
