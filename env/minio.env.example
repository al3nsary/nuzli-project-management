# DEVELOPMENT ONLY — MinIO stand-in for OCI Object Storage (docker-compose.dev.yml).
#   cp env/minio.env.example env/minio.env
# Use the same values as S3_ACCESS_KEY / S3_SECRET_KEY in env/api.env. Secret: ≥ 8 characters.
MINIO_ROOT_USER=nuzli-dev
MINIO_ROOT_PASSWORD=CHANGE_ME_dev_minio_secret
S3_BUCKET=nuzli
