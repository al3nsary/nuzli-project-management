# ─────────────────────────────────────────────────────────────────────────────
# Nuzli API — secrets and settings for the `api` container ONLY (ADR-068).
#   cp env/api.env.example env/api.env      then replace every CHANGE_ME value.
# The API refuses to start in production while any secret below still contains CHANGE_ME,
# is not base64 of enough random bytes, or looks hand-typed (security review H1).
# This file must NOT contain the backup passphrase; env/backup.env must NOT contain these keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# Public origin of the web app (used in e-mail links: set-password, reset-password).
PUBLIC_WEB_URL=https://localhost
# Extra origins allowed to call the API with credentials (comma separated).
# Leave empty when the web app is served by the bundled proxy (same origin).
# Add http://localhost:5173 when running Vite on the host in development.
CORS_ORIGINS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Swagger UI at /api/docs. Unset = on in development, OFF in production (security review L5).
# Set true in production only for a deliberate, temporary reason.
SWAGGER_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
# Two roles (A12, ADR-143 / ADR-152 — docs/deployment-rls.md):
#  DATABASE_URL      the MIGRATOR (schema owner = POSTGRES_USER of env/db.env): runs
#                    `prisma migrate deploy` and the seed at every start. Same password as env/db.env.
#  APP_DATABASE_URL  the API itself, as the role `nuzli_app` (created by the A12 migration: no
#                    superuser, no BYPASSRLS) — PostgreSQL Row Level Security applies to every
#                    request. Choose its own password (URL-safe characters); the seed gives the role
#                    LOGIN with this password at every start, so nothing has to be run by hand:
#                      openssl rand -base64 32 | tr -d '+/=' | cut -c1-32
# URL-safe password characters only (letters, digits, - _ .).
DATABASE_URL=postgresql://nuzli:CHANGE_ME_db_password@db:5432/nuzli?schema=public
APP_DATABASE_URL=postgresql://nuzli_app:CHANGE_ME_app_password@db:5432/nuzli?schema=public
# true = the API refuses to start when its role bypasses RLS (forced on in docker-compose.prod.yml).
DB_REQUIRE_RLS=false

# ── Authentication (ADR-010, ADR-062) ────────────────────────────────────────
# HS256 signing secret for 15-minute access tokens. Base64 of ≥ 32 random bytes:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME__generate_with__openssl_rand_-base64_48
JWT_ACCESS_TTL_SECONDS=900
# Rotating refresh token lifetime (cookie nz_rt, httpOnly, Secure, SameSite=Strict).
REFRESH_TOKEN_TTL_DAYS=30
# Always true in production (forced). Only automated plain-http tests set false.
COOKIE_SECURE=true
# Requests per minute per IP: all endpoints / auth endpoints.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
# Short account lock after N failed password checks (per-IP and per-identifier progressive
# delays apply first). A lock never shows as "locked"; a password reset lifts it.
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=5

# ── First owner (created by the seed ONLY on an empty system: no owner, no admin) ─
# A12 round 2: the username is enough. Leave BOOTSTRAP_OWNER_PASSWORD empty to get a random
# temporary password printed ONCE in the API log of the first start (docker compose logs api);
# only its hash is stored. Either way the owner must change it at first login. The seed refuses
# any value containing CHANGE_ME. E-mail, mobile and national ID below are optional: without
# them the owner gets neutral placeholders to replace in user management. Remove the password
# after the first start.
BOOTSTRAP_OWNER_USERNAME=mmansary
BOOTSTRAP_OWNER_PASSWORD=
# Optional: further existing accounts (e-mails, comma separated) promoted to OWNER on the FIRST
# boot only (ignored once an owner exists — ADR-163).
# BOOTSTRAP_OWNER_EMAIL=
# Optional identity of the first owner (all of e-mail, mobile and national ID, or none):
# BOOTSTRAP_ADMIN_EMAIL=owner@example.sa
# Older name of BOOTSTRAP_OWNER_PASSWORD (still read when the new one is empty).
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=المالك
# 05XXXXXXXX or +9665XXXXXXXX
# BOOTSTRAP_ADMIN_MOBILE=05XXXXXXXX
# Valid Saudi national ID / Iqama (10 digits, check digit). Stored encrypted.
# BOOTSTRAP_ADMIN_NATIONAL_ID=

# ── National ID protection (ADR-011; rotation: docs/backup-restore.md) ───────
# AES-256-GCM key, base64 of exactly 32 random bytes, prefixed with its version:
#   echo "v1:$(openssl rand -base64 32)"
NATIONAL_ID_ENC_KEY=CHANGE_ME
# During key rotation: previous keys kept for decryption, comma separated (v1:...,v2:...).
NATIONAL_ID_ENC_KEYS_OLD=
# HMAC-SHA256 key for the blind index, base64 of 32 random bytes, different from the key above:
#   openssl rand -base64 32
# Changing it requires apps/api/src/scripts/rotate-national-id-key.ts (API stopped).
NATIONAL_ID_HMAC_KEY=CHANGE_ME

# ── Object storage (ADR-012) ─────────────────────────────────────────────────
# Production (OCI Object Storage, S3-compatible API):
#   S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION=<region, e.g. me-jeddah-1>
#   S3_ACCESS_KEY / S3_SECRET_KEY = an OCI "Customer Secret Key" for the APP bucket only
# Development: MinIO from docker-compose.dev.yml; use the same values as env/minio.env.
S3_ENDPOINT=http://minio:9000
# Endpoint used only to SIGN browser URLs when it differs from S3_ENDPOINT (dev proxy).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# The bucket is private. In dev it must be "nuzli" unless you edit infra/nginx/dev-storage.conf.
# Recommended: a lifecycle rule deleting objects under pending/ after 1 day (ADR-065).
S3_BUCKET=nuzli
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# ── E-mail (SMTP; mailpit in dev) ────────────────────────────────────────────
# smtp | noop (noop keeps messages in memory — tests only)
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=نزلي <no-reply@example.sa>

# ── Optional server-side PDF renderer (ADR-024/043/073) ──────────────────────
# Internal `backend` network only (never published), e.g. http://pdf:4000. Every request
# carries PDF_SERVICE_TOKEN in X-Pdf-Service-Token; required in production with the URL:
#   openssl rand -base64 48
# Not built yet: without PDF_SERVICE_URL the server-side PDF endpoints answer 501 and the browser's
# print dialog makes the PDF (docs/printing.md). Leave both commented.
# PDF_SERVICE_URL=
# PDF_SERVICE_TOKEN=
# PDF_SERVICE_TIMEOUT_MS=60000

# ── Server-side OCR of violation ID-card photos (ADR-104, self-hosted data, no CDN) ─
# One WASM worker costs about 150–250 MB of the API's memory limit. false = jobs stay pending.
OCR_ENABLED=true
# Parallel OCR jobs (1–2) and attempts before a job is marked failed.
OCR_CONCURRENCY=1
OCR_MAX_ATTEMPTS=3

# ── A9 project imports (ADR-110..112) ───────────────────────────────────────
# MS Project .mpp converter (infra/converter, compose service `converter`, backend network only).
# Unset → importing an .mpp answers 501 MPP_CONVERTER_NOT_CONFIGURED and asks the admin to save
# the file as XML in MS Project. CONVERTER_TOKEN must equal CONVERTER_TOKEN in env/converter.env
# and is required in production with the URL:   openssl rand -base64 48
CONVERTER_URL=http://converter:8080
CONVERTER_TOKEN=CHANGE_ME__generate_with__openssl_rand_-base64_48
CONVERTER_TIMEOUT_MS=60000
# Jira Cloud REST imports reach https://<site>.atlassian.net only. Self-hosted Jira (Data Center)
# hosts can be allowed here, exact host names, comma separated (they must resolve to public IPs).
JIRA_ALLOWED_HOSTS=
