# ─────────────────────────────────────────────────────────────────────────────
# Nuzli converter (.mpp → MS Project XML, MPXJ) — settings for the `converter` container ONLY
# (owner request A9, ADR-111).   cp env/converter.env.example env/converter.env
# The service is reachable only on the internal `backend` network and refuses every request
# without this token. Use the SAME value as CONVERTER_TOKEN in env/api.env:
#   openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
CONVERTER_TOKEN=CHANGE_ME__generate_with__openssl_rand_-base64_48
# Largest .mpp accepted (bytes). The API already caps imports at 20 MB.
CONVERTER_MAX_BYTES=20971520
# A conversion taking longer is aborted (504). Keep it below the API's CONVERTER_TIMEOUT_MS.
CONVERTER_TIMEOUT_SECONDS=50
# Parallel conversions (1–4); each may use a few hundred MB of memory for large plans.
CONVERTER_CONCURRENCY=2
