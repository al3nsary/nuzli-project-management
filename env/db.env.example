# PostgreSQL 16 — the `db` container ONLY (ADR-068).
#   cp env/db.env.example env/db.env      then set the password.
# URL-safe characters only (letters, digits, - _ .): it is repeated inside DATABASE_URL in
# env/api.env and as PGPASSWORD in env/backup.env.
#   openssl rand -base64 32 | tr -d '+/=' | cut -c1-32
POSTGRES_DB=nuzli
POSTGRES_USER=nuzli
POSTGRES_PASSWORD=CHANGE_ME_db_password
