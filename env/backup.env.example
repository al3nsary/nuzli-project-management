# ─────────────────────────────────────────────────────────────────────────────
# Encrypted backups — the `backup` container ONLY (ADR-068, docs/backup-restore.md).
#   cp env/backup.env.example env/backup.env      then replace every CHANGE_ME value.
# This file holds NO national-ID keys, JWT secret or app S3 keys, and env/api.env holds no
# backup passphrase: one leaked container never yields both the dump and its keys.
# ─────────────────────────────────────────────────────────────────────────────

# Database connection (read-only use: pg_dump; restore.sh also creates a scratch database).
PGHOST=db
PGPORT=5432
PGDATABASE=nuzli
PGUSER=nuzli
PGPASSWORD=CHANGE_ME_db_password

# Symmetric passphrase for gpg (AES-256, integrity-protected; security review L1).
# At least 40 characters of random data. Keep a copy OUTSIDE the server (password manager /
# sealed envelope): without it the backups cannot be restored.
#   openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME
# Only for restoring LEGACY *.sql.gz.enc backups (openssl, before gpg): their PBKDF2 iterations.
# BACKUP_PBKDF2_ITER=200000
# Daily time in UTC (HH:MM). 02:00 UTC = 05:00 Riyadh.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=14
# Take one backup when the container starts.
BACKUP_ON_START=false

# Off-site copy to an S3-compatible bucket. Disabled unless set to true. When enabled, every
# BACKUP_S3_* value is required: use a SEPARATE bucket and credentials that can only write
# (no delete), with retention / object lock — never the app bucket or the app's keys.
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
