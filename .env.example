# ─────────────────────────────────────────────────────────────────────────────
# Nuzli — docker compose settings (NOT secrets). Copy to `.env`:
#   cp .env.example .env
#
# Secrets live in one file per service under env/ (security review M6, ADR-068):
#   cp env/api.env.example    env/api.env      # API: JWT, national-ID keys, app S3, SMTP, DB URLs
#                                              #  (DATABASE_URL = migrator, APP_DATABASE_URL = nuzli_app,
#                                              #   Row Level Security — docs/deployment-rls.md)
#   cp env/db.env.example     env/db.env       # PostgreSQL password
#   cp env/backup.env.example env/backup.env   # backup passphrase + its own bucket/keys
#   cp env/minio.env.example  env/minio.env    # development only
# Replace every CHANGE_ME. The placeholders are deliberately invalid: the API refuses to start
# in production with any of them, and the seed refuses a CHANGE_ME bootstrap password.
# Generate secrets with:
#   openssl rand -base64 48                  JWT_ACCESS_SECRET, PDF_SERVICE_TOKEN, backup passphrase
#   echo "v1:$(openssl rand -base64 32)"     NATIONAL_ID_ENC_KEY
#   openssl rand -base64 32                  NATIONAL_ID_HMAC_KEY (a different value)
# Never commit `.env` or env/*.env.
# ─────────────────────────────────────────────────────────────────────────────

# Image tag used by docker compose.
NUZLI_VERSION=latest

# ── Proxy (nginx) ────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Folder with fullchain.pem + privkey.pem (dev: mkcert, prod: Let's Encrypt live dir).
CERTS_DIR=./infra/certs
# DEV ONLY: origin the browser uses to reach MinIO through the proxy (phones on the LAN:
# https://<your-lan-ip>). See infra/nginx/dev-storage.conf.
DEV_PUBLIC_ORIGIN=https://localhost
