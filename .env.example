# ─────────────────────────────────────────────────────────────────────────────
# Nuzli — environment configuration. Copy to `.env` and fill in every CHANGE_ME.
#   cp .env.example .env
# The API validates this file at start-up and refuses to run with missing or bad values.
# Never commit `.env`. Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# Image tag used by docker compose.
NUZLI_VERSION=latest
# Public origin of the web app (used in e-mail links: set-password, reset-password).
PUBLIC_WEB_URL=https://localhost
# Extra origins allowed to call the API with credentials (comma separated).
# Leave empty when the web app is served by the bundled proxy (same origin).
# Add http://localhost:5173 when running Vite on the host in development.
CORS_ORIGINS=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Swagger UI at /api/docs (the prod override defaults it to false).
SWAGGER_ENABLED=true

# ── Proxy (nginx) ────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Folder with fullchain.pem + privkey.pem (dev: mkcert, prod: Let's Encrypt live dir).
CERTS_DIR=./infra/certs
# DEV ONLY: origin the browser uses to reach MinIO through the proxy (phones on the LAN:
# https://<your-lan-ip>). See infra/nginx/dev-storage.conf.
DEV_PUBLIC_ORIGIN=https://localhost

# ── PostgreSQL 16 ────────────────────────────────────────────────────────────
POSTGRES_DB=nuzli
POSTGRES_USER=nuzli
# URL-safe characters only (letters, digits, - _ .), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Optional: full connection string (overrides the one built from the values above).
# DATABASE_URL=postgresql://nuzli:password@db:5432/nuzli?schema=public

# ── Authentication (ADR-010) ─────────────────────────────────────────────────
# HS256 signing secret for 15-minute access tokens. ≥ 32 characters, random.
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_random_characters_here
JWT_ACCESS_TTL_SECONDS=900
# Rotating refresh token lifetime (cookie nz_rt, httpOnly, Secure, SameSite=Strict).
REFRESH_TOKEN_TTL_DAYS=30
# Always true in production (forced). Only automated plain-http tests set false.
COOKIE_SECURE=true
# Requests per minute per IP: all endpoints / auth endpoints.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
# Lockout after N failed logins, for M minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ── First admin (created by the seed ONLY when no admin exists) ──────────────
# The admin must change this password at first login. Remove these values afterwards if you wish.
BOOTSTRAP_ADMIN_EMAIL=admin@example.sa
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_Admin12345
BOOTSTRAP_ADMIN_NAME=مدير النظام
# 05XXXXXXXX or +9665XXXXXXXX
BOOTSTRAP_ADMIN_MOBILE=0500000000
# Valid Saudi national ID / Iqama (10 digits, check digit). Stored encrypted.
BOOTSTRAP_ADMIN_NATIONAL_ID=CHANGE_ME

# ── National ID protection (ADR-011) ─────────────────────────────────────────
# AES-256-GCM key, base64 of exactly 32 bytes, optionally prefixed with its version (v1:...).
#   echo "v1:$(openssl rand -base64 32)"
NATIONAL_ID_ENC_KEY=CHANGE_ME
# During key rotation: previous keys kept for decryption, comma separated (v1:...,v2:...).
NATIONAL_ID_ENC_KEYS_OLD=
# HMAC-SHA256 key for the blind index (exact lookup + uniqueness). base64, 32 bytes.
# Changing it requires recomputing every national_id_hash — keep it stable.
NATIONAL_ID_HMAC_KEY=CHANGE_ME

# ── Object storage (ADR-012) ─────────────────────────────────────────────────
# Production (OCI Object Storage, S3-compatible API):
#   S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION=<region, e.g. me-jeddah-1>
#   S3_ACCESS_KEY / S3_SECRET_KEY = an OCI "Customer Secret Key"
# Development: MinIO from docker-compose.dev.yml (the dev override sets S3_ENDPOINT itself;
# S3_ACCESS_KEY / S3_SECRET_KEY below also become the MinIO root credentials).
S3_ENDPOINT=http://minio:9000
# Endpoint used only to SIGN browser URLs when it differs from S3_ENDPOINT (dev proxy).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# The bucket is private. In dev it must be "nuzli" unless you edit infra/nginx/dev-storage.conf.
S3_BUCKET=nuzli
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_secret_min_8_chars
S3_FORCE_PATH_STYLE=true

# ── E-mail (SMTP; mailpit in dev) ────────────────────────────────────────────
# smtp | noop (noop keeps messages in memory — tests only)
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=نزلي <no-reply@example.sa>

# ── Backups (infra/backup) ───────────────────────────────────────────────────
# Passphrase for openssl AES-256-CBC (PBKDF2). Store it OUTSIDE the server too:
# without it the backups cannot be restored.
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_long_random_passphrase
# Daily time in UTC (HH:MM). 02:00 UTC = 05:00 Riyadh.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=14
# Take one backup when the container starts.
BACKUP_ON_START=false
# Upload each backup to an S3-compatible bucket (the prod override turns this on).
BACKUP_S3_ENABLED=false
# Defaults: S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY. A separate bucket is recommended.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
